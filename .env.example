# Telegram username of the shop-control bot (from @BotFather) — used for the
# "Open in Telegram" link when this panel is opened outside Telegram.
VITE_SHOP_BOT_USERNAME=

# Only needed if the API/socket server isn't reachable via the dev proxy or
# same origin as this panel (e.g. pointing a deployed panel at a separate API host).
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
